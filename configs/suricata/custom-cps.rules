# Version 2 rules for the four modeled CPS assets.

alert tcp any any -> $HOME_NET $MODBUS_PORTS (msg:"CPS Suspicious Modbus Traffic"; flow:established,to_server; content:"|FF FF|"; depth:2; threshold:type both, track by_src, count 10, seconds 30; classtype:attempted-recon; sid:1000001; rev:2;)

alert tcp any any -> $HOME_NET $SSH_PORTS (msg:"CPS Repeated SSH Connection Attempts"; flags:S; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:1000003; rev:2;)

alert tcp any any -> $HOME_NET $HTTP_PORTS (msg:"CPS Possible SQL Injection Probe"; flow:to_server,established; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000004; rev:2;)

alert tcp $OT_NET any -> $EXTERNAL_NET any (msg:"CPS Repeated Connections from OT to External Network"; flow:established,to_server; threshold:type both, track by_dst, count 100, seconds 30; classtype:policy-violation; sid:1000007; rev:2;)

alert tcp any any -> $HOME_NET $MODBUS_PORTS (msg:"CPS PLC Write Multiple Coils Request"; flow:established,to_server; content:"|0F|"; offset:7; depth:1; classtype:policy-violation; sid:1000008; rev:2;)

alert icmp any any -> $HOME_NET any (msg:"CPS Repeated ICMP Discovery"; itype:8; threshold:type both, track by_src, count 50, seconds 30; classtype:attempted-recon; sid:1000009; rev:2;)

alert tcp any any -> $HOME_NET any (msg:"CPS Rapid TCP Connection Attempts"; flags:S; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:1000014; rev:2;)

alert tcp $HOME_NET any -> $HOME_NET $SSH_PORTS (msg:"CPS Repeated Internal SSH Connections"; flow:established,to_server; threshold:type both, track by_src, count 5, seconds 60; classtype:policy-violation; sid:1000018; rev:2;)

alert tcp any any -> $HOME_NET 44818 (msg:"CPS EtherNet/IP SendRRData Request"; flow:established,to_server; content:"|6F 00|"; depth:2; classtype:protocol-command-decode; sid:1000019; rev:2;)
